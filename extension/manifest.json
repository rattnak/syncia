{
  "manifest_version": 3,
  "name": "Syncia",
  "version": "0.1.0",
  "description": "Project-scoped team coordination for FHSU TILT staff",

  "permissions": [
    "sidePanel",
    "storage",
    "identity"
  ],

  "host_permissions": [
    "https://teams.microsoft.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "action": {
    "default_title": "Open Syncia",
    "default_icon": {
      "16": "public/icon16.png",
      "48": "public/icon48.png",
      "128": "public/icon128.png"
    }
  },

  "icons": {
    "16": "public/icon16.png",
    "48": "public/icon48.png",
    "128": "public/icon128.png"
  }
}
