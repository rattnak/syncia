NEXT_PUBLIC_SITE_URL=http://localhost:3000 # change to Vercel URL in production

# Set to "true" to bypass all auth and use mock data (frontend preview only)
DEMO_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key is only needed for cron operations (hearts reset)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (Claude Haiku) — Phase 5 AI Agent
ANTHROPIC_API_KEY=your-anthropic-api-key

# Vercel cron secret — hearts reset endpoint
CRON_SECRET=your-cron-secret-here  # generate with: openssl rand -hex 32

# NextAuth + Azure Entra (Microsoft SSO)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here  # generate with: openssl rand -base64 32
AZURE_AD_CLIENT_ID=your-azure-ad-app-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-fhsu-tenant-id

# ─── Microsoft Teams Channel Integration ─────────────────────────────────────
# GRAPH_TEAM_ID: The object ID of the FHSU-wide Microsoft Team in which Syncia
# will create private channels. Find it in Teams Admin Center → Teams → pick team → copy ID.
#
# All Teams operations use DELEGATED permissions (scoped to the signed-in user),
# NOT application-level permissions. No tenant-wide access is required.
#
# Required delegated permissions on the Azure AD app registration
# (admin-consent them under API permissions → Microsoft Graph → Delegated):
#   Channel.ReadBasic.All
#   Channel.Create
#   ChannelMember.ReadWrite.All
#   ChannelMessage.Read.All
#
# Teams.Create and TeamMember.ReadWrite.All as Application permissions are
# intentionally NOT needed — all operations run as the signed-in user.
GRAPH_TEAM_ID=your-fhsu-teams-team-object-id

# ─── Outlook Calendar Integration ────────────────────────────────────────────
# Required delegated permissions (also admin-consent these):
#   Calendars.Read
#   Calendars.ReadWrite
# These are requested at sign-in via the NextAuth scope in lib/auth.ts.
# No additional env vars needed — the access token flows through the NextAuth session.
